"""
Diagnostics.py
--------------
Призначення:
    Модуль діагностики MotherCube.
    Використовується CoreEngine та CopilotAssistant.
    Дозволяє перевіряти стан системи, продуктивність та підписки модулів.

Принцип:
    - Виконує health-check для модулів.
    - Аналізує продуктивність (час тіку, кількість подій).
    - Виявляє потенційні проблеми (цикли, перевантаження).
"""

import time
from Core.Logger import Logger


class Diagnostics:
    def __init__(self, event_bus, registry, event_queue, logger: Logger):
        self.event_bus = event_bus
        self.registry = registry
        self.event_queue = event_queue
        self.logger = logger

    def health_check(self):
        """Перевіряє стан модулів у Registry."""
        modules = self.registry.list_modules()
        if not modules:
            self.logger.warning("Registry порожній — модулі не зареєстровані.", module="Diagnostics")
        else:
            self.logger.info(f"Зареєстровано {len(modules)} модулів.", module="Diagnostics")
        return modules

    def performance_check(self, tick_start: float, tick_end: float):
        """Аналізує продуктивність одного тіку."""
        duration = tick_end - tick_start
        queue_size = self.event_queue.size()
        self.logger.debug(
            f"Тік виконувався {duration:.4f} сек. | Подій у черзі: {queue_size}",
            module="Diagnostics"
        )
        return {"duration": duration, "queue_size": queue_size}

    def detect_cycles(self):
        """Виявляє потенційні циклічні залежності між модулями."""
        dependencies = self.registry.list_dependencies()
        cycles = []
        for module, data in dependencies.items():
            for event in data["generates"]:
                for other_module, other_data in dependencies.items():
                    if module != other_module and event in other_data["listens"]:
                        if module in other_data["generates"]:
                            cycles.append((module, other_module))
        if cycles:
            self.logger.warning(f"Виявлено циклічні залежності: {cycles}", module="Diagnostics")
        else:
            self.logger.info("Циклічних залежностей не знайдено.", module="Diagnostics")
        return cycles
