"""
EventQueue.py
-------------
Призначення:
    Керує чергою подій MotherCube.
    Використовується CoreEngine та EventBus.
    Забезпечує контрольований порядок обробки подій,
    щоб уникнути перевантаження системи.

Принцип:
    - Події додаються у чергу.
    - CoreEngine витягує їх по одному.
    - Обмеження на кількість подій (з Config).
"""

from collections import deque
from typing import Any, Dict
from Core.Config import EVENT_QUEUE_LIMIT


class EventQueue:
    def __init__(self):
        self._queue = deque()

    def push(self, event_name: str, data: Any = None):
        """Додає подію у чергу."""
        if len(self._queue) >= EVENT_QUEUE_LIMIT:
            raise OverflowError("⚠️ Черга подій переповнена!")
        self._queue.append({"event": event_name, "data": data})

    def pop(self) -> Dict[str, Any]:
        """Витягує наступну подію з черги."""
        if self._queue:
            return self._queue.popleft()
        return {}

    def peek(self) -> Dict[str, Any]:
        """Дивиться на першу подію без видалення."""
        if self._queue:
            return self._queue[0]
        return {}

    def size(self) -> int:
        """Повертає кількість подій у черзі."""
        return len(self._queue)

    def clear(self):
        """Очищає чергу подій."""
        self._queue.clear()
